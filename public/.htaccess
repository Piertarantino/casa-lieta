# Aruba (Apache): redirect 301 dai vecchi URL del sito 2012, cache e compressione.
# Il passaggio forzato a HTTPS e a www si attiva dal pannello Aruba (evita loop di redirect).
AddDefaultCharset utf-8

# Google ha ancora in indice i vecchi indirizzi anche SENZA ".php" (es. /camera1, /dintorni):
# RedirectMatch copre entrambe le forme, con o senza barra finale.
RedirectMatch 301 ^/index(\.php)?$ /
RedirectMatch 301 ^/camera[123](\.php)?/?$ /#camere
RedirectMatch 301 ^/monolocale(\.php)?/?$ /#camere
RedirectMatch 301 ^/tariffe(\.php)?/?$ /#prenota
RedirectMatch 301 ^/(dovesiamo|contatti)(\.php)?/?$ /#dove
RedirectMatch 301 ^/dintorni(\.php)?/?$ /#dintorni
RedirectMatch 301 ^/(offertespeciali|ristorante)(\.php)?/?$ /
Redirect 301 /offerte-casavacanze.html /
Redirect 301 /virtual-tour-3d.html /
Redirect 301 /imsitemap.html /
Redirect 301 /casa_vacanze_beb_casa_lieta.html /
Redirect 301 /sitemap.xml /sitemap-index.xml

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml text/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
