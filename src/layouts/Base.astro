---
import '@fontsource/marcellus/latin-400.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITO, STAGIONE_FORZATA } from '../config';
import { stagioneDaData, CONFINI } from '../data/stagioni';
import { getCollection } from 'astro:content';
import db from '../data/notizie.json';

interface Props { titolo: string; descrizione: string; immagine?: string; jsonld?: object[]; noindex?: boolean }
const { titolo, descrizione, immagine = '/og-casa-lieta.jpg', jsonld = [], noindex = false } = Astro.props;
const nCamere = (await getCollection('alloggi', (a) => a.data.attivo && a.data.sede === 'marciano')).length;
const oggiISO = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Rome' });
const haNotizie = db.notizie.some((n: any) => n.stato === 'pubblicata' && (n.fine ?? n.data) >= oggiISO);
const canonical = new URL(Astro.url.pathname, SITO.url).href;
const stagioneBuild = STAGIONE_FORZATA === 'auto' ? stagioneDaData() : STAGIONE_FORZATA;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': ['LodgingBusiness', 'BedAndBreakfast'],
    name: SITO.nome,
    description: SITO.descrizione,
    url: SITO.url,
    telephone: SITO.telefono.replace(/\s/g, ''),
    email: SITO.email,
    image: new URL(immagine, SITO.url).href,
    address: { '@type': 'PostalAddress', streetAddress: SITO.indirizzo.via, postalCode: SITO.indirizzo.cap, addressLocality: SITO.indirizzo.citta, addressRegion: SITO.indirizzo.provincia, addressCountry: 'IT' },
    geo: { '@type': 'GeoCoordinates', latitude: SITO.geo.lat, longitude: SITO.geo.lng },
    containedInPlace: { '@type': 'Place', name: 'Parco Naturale Regionale dei Monti Simbruini' },
    hasMap: SITO.mappa,
    numberOfRooms: nCamere,
    petsAllowed: true,
    amenityFeature: ['Parcheggio gratuito', 'Colazione inclusa', 'Area barbecue', 'Cucina in comune', 'Terrazzo panoramico'].map((n) => ({ '@type': 'LocationFeatureSpecification', name: n, value: true })),
    sameAs: [SITO.facebook, ...SITO.portali.map((p) => p.url).filter(Boolean)],
  },
  ...jsonld,
];
---
<!doctype html>
<html lang="it" data-season={stagioneBuild}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titolo}</title>
  <meta name="description" content={descrizione} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#243F2D" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:site_name" content={SITO.nome} />
  <meta property="og:title" content={titolo} />
  <meta property="og:description" content={descrizione} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(immagine, SITO.url).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="geo.region" content="IT-RM" />
  <meta name="geo.placename" content="Subiaco" />
  <meta name="geo.position" content={`${SITO.geo.lat};${SITO.geo.lng}`} />
  <script is:inline define:vars={{ forzata: STAGIONE_FORZATA, confini: CONFINI }}>
    // Sceglie la stagione dalla data del visitatore, prima che la pagina si disegni.
    (function () {
      var s = forzata;
      if (s === 'auto') {
        var d = new Date(), doy = Math.floor((d - new Date(d.getFullYear(), 0, 0)) / 864e5);
        s = 'inverno';
        for (var i = 0; i < confini.length; i++) if (doy > confini[i][1] && doy <= confini[i][2]) { s = confini[i][0]; break; }
      }
      try { var p = new URLSearchParams(location.search).get('stagione'); if (['primavera','estate','autunno','inverno'].indexOf(p) > -1) s = p; } catch (e) {}
      document.documentElement.dataset.season = s;
      document.documentElement.classList.add('js');
    })();
  </script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
  <a class="skip" href="#contenuto">Vai al contenuto</a>
  <Header notizie={haNotizie} />
  <main id="contenuto"><slot /></main>
  <Footer notizie={haNotizie} />
  <script>
    // Le sezioni entrano con una leggera dissolvenza mentre si scorre.
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.rivela').forEach((el) => io.observe(el));
  </script>
  <style is:global>
    html.js .rivela{opacity:0;transform:translateY(18px);transition:opacity .8s ease,transform .8s ease}
    html.js .rivela.in{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){html.js .rivela{opacity:1;transform:none}*,*::before,*::after{animation:none!important}}
  </style>
</body>
</html>
