---
// Particelle stagionali nell'apertura: neve d'inverno, foglie d'autunno,
// petali in primavera, lucciole d'estate. Si fermano fuori schermo e con
// "riduci movimento".
---
<canvas class="atmosfera" aria-hidden="true"></canvas>
<script>
  const cv = document.querySelector<HTMLCanvasElement>('.atmosfera')!;
  const ctx = cv.getContext('2d')!;
  const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type P = { x: number; y: number; s: number; v: number; w: number; r: number; c: string };
  let ps: P[] = [], raf = 0, visibile = true, stagione = '';
  const COL: Record<string, string[]> = {
    inverno: ['rgba(255,255,255,.9)'],
    autunno: ['#B5652E', '#C98A2F', '#8E4423', '#D9A441'],
    primavera: ['rgba(255,255,255,.85)', 'rgba(247,214,224,.9)', 'rgba(232,212,90,.8)'],
    estate: ['rgba(255,236,160,.9)'],
  };
  function init() {
    stagione = document.documentElement.dataset.season || 'estate';
    const b = cv.parentElement!.getBoundingClientRect();
    const dpr = Math.min(devicePixelRatio || 1, 2);
    cv.width = b.width * dpr; cv.height = b.height * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = { inverno: b.width / 8, autunno: b.width / 40, primavera: b.width / 45, estate: b.width / 50 }[stagione] ?? 20;
    const cs = COL[stagione] ?? COL.estate;
    ps = Array.from({ length: Math.round(n) }, () => ({
      x: Math.random() * b.width, y: Math.random() * b.height,
      s: stagione === 'inverno' ? Math.random() * 2 + 0.6 : Math.random() * 3 + 3,
      v: stagione === 'estate' ? (Math.random() - 0.5) * 0.2 : Math.random() * 0.5 + 0.3,
      w: Math.random() * 6, r: Math.random() * 6, c: cs[Math.floor(Math.random() * cs.length)],
    }));
  }
  function tick(t: number) {
    const W = cv.clientWidth, H = cv.clientHeight;
    ctx.clearRect(0, 0, W, H);
    for (const p of ps) {
      p.w += 0.012;
      if (stagione === 'estate') {
        p.x += Math.sin(p.w) * 0.35; p.y += p.v + Math.cos(p.w * 0.7) * 0.2;
        const a = 0.35 + 0.65 * Math.max(0, Math.sin(t / 900 + p.r));
        ctx.globalAlpha = a; ctx.fillStyle = p.c; ctx.shadowColor = p.c; ctx.shadowBlur = 10;
        ctx.beginPath(); ctx.arc(p.x, p.y, 1.8, 0, 6.283); ctx.fill(); ctx.shadowBlur = 0; ctx.globalAlpha = 1;
      } else if (stagione === 'inverno') {
        p.y += p.v; p.x += Math.sin(p.w) * 0.3;
        ctx.fillStyle = p.c; ctx.beginPath(); ctx.arc(p.x, p.y, p.s, 0, 6.283); ctx.fill();
      } else {
        p.y += p.v; p.x += Math.sin(p.w) * 0.8 + 0.25; p.r += 0.02;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r); ctx.scale(1, Math.abs(Math.sin(p.w * 2)) * 0.6 + 0.4);
        ctx.fillStyle = p.c; ctx.beginPath(); ctx.ellipse(0, 0, p.s, p.s * 0.55, 0, 0, 6.283); ctx.fill(); ctx.restore();
      }
      if (p.y > H + 10) { p.y = -10; p.x = Math.random() * W; }
      if (p.y < -12) p.y = H + 8;
      if (p.x > W + 10) p.x = -10; if (p.x < -12) p.x = W + 8;
    }
    if (visibile) raf = requestAnimationFrame(tick);
  }
  if (!ridotto) {
    init();
    new IntersectionObserver(([e]) => { visibile = e.isIntersecting; cancelAnimationFrame(raf); if (visibile) raf = requestAnimationFrame(tick); }).observe(cv);
    addEventListener('resize', () => init());
    new MutationObserver(() => init()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-season'] });
  }
</script>
<style>.atmosfera{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}</style>
