---
import db from '../data/notizie.json';
import Icona from './Icona.astro';
const oggi = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Rome' });
const pubblicate = db.notizie
  .filter((n) => n.stato === 'pubblicata' && ((n as any).fine ?? n.data) >= oggi)
  .sort((a, b) => a.data.localeCompare(b.data))
  .slice(0, 6);
const mesi = ['gen', 'feb', 'mar', 'apr', 'mag', 'giu', 'lug', 'ago', 'set', 'ott', 'nov', 'dic'];
const agg = new Date(db.aggiornato).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', timeZone: 'Europe/Rome' });
const esempi = pubblicate.some((n) => (n as any).esempio);
---
{pubblicate.length > 0 && (<section class="blocco" id="notizie">
  <div class="wrap">
    <div class="sechead rivela">
      <div>
        <div class="eyebrow">Aggiornato il <span id="n-agg">{agg}</span>{esempi && <> · <span class="tag">esempi</span></>}</div>
        <h2>Cosa succede intorno</h2>
      </div>
      <p>Eventi, sagre e attività entro 30 km dalla casa, scelti ogni mattina. Le notizie che non servono a chi viene in vacanza restano fuori.</p>
    </div>
    <ul class="feed rivela" id="feed">
      {pubblicate.map((n) => {
        const d = new Date(n.data + 'T12:00:00');
        const Tag = n.url ? 'a' : 'div';
        return (
          <li data-data={(n as any).fine ?? n.data}>
            <div class="date"><b>{d.getDate()}</b><small>{mesi[d.getMonth()]}</small></div>
            <Tag class="corpo" {...(n.url ? { href: n.url, rel: 'noopener', target: '_blank' } : {})}>
              <h3>{n.titolo}</h3>
              {n.riassunto && <p>{n.riassunto}</p>}
              <div class="where"><Icona nome="pin" size={16} />{n.luogo} · {n.km} km da casa · <span class="tag">{n.categoria}</span></div>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>)}
<script>
  // Toglie gli eventi già passati secondo la data del visitatore.
  const oggi = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Rome' });
  document.querySelectorAll<HTMLElement>('#feed li').forEach((li) => { if ((li.dataset.data ?? '') < oggi) li.remove(); });
</script>
<style>
.feed{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:0 40px;border-top:1px solid var(--line)}
.feed li{display:grid;grid-template-columns:64px 1fr;gap:18px;align-items:start;padding:20px 0;border-bottom:1px solid var(--line)}
.date{text-align:center;font-family:var(--mono);line-height:1.1}
.date b{display:block;font-family:var(--display);font-weight:400;font-size:2.1rem;color:var(--accent)}
.date small{font-size:.76rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.corpo{text-decoration:none;display:block;min-width:0}
a.corpo:hover h3{color:var(--accent)}
.corpo h3{font-family:var(--body);font-weight:600;font-size:1.1rem;line-height:1.35;transition:color .2s}
.corpo p{font-size:.98rem;color:var(--text);margin-top:4px}
.where{display:flex;flex-wrap:wrap;align-items:center;gap:4px 6px;font-size:.9rem;color:var(--muted);margin-top:8px}
.where :global(.ico){color:var(--accent)}
.vuoto{color:var(--muted)}
@media (max-width:820px){.feed{grid-template-columns:1fr}}
</style>
