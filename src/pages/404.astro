---
import Base from '../layouts/Base.astro';
---
<Base titolo="Pagina non trovata · Casa Lieta" descrizione="La pagina che cercavi non esiste più." noindex>
  <div class="wrap" style="padding-block:96px 0;max-width:640px">
    <div class="eyebrow">Errore 404</div>
    <h1 style="font-size:clamp(2.2rem,5vw,3.4rem);margin:10px 0 16px">Questo sentiero non porta da nessuna parte.</h1>
    <p style="color:var(--muted);margin-bottom:24px">Il sito di Casa Lieta è stato rinnovato e alcune pagine hanno cambiato indirizzo.</p>
    <a class="btn" href="/">Torna alla casa</a>
  </div>
</Base>
